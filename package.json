{
  "name": "socialbook",
  "version": "2.0.0",
  "private": true,
  "description": "R\u00e9seau social d\u00e9di\u00e9 aux entra\u00eenements",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "node dist/server.js",
    "dev": "tsx watch server.ts",
    "client": "npm run dev --workspace client",
    "build": "tsc && npm run build --workspace client",
    "test": "tsx --test --test-concurrency=1 tests/*.test.js",
    "typecheck": "tsc --noEmit && tsc -p client/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "e2e": "tsx tests/e2e.ts"
  },
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "validator": "^13.15.35",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/validator": "^13.15.10",
    "eslint": "^10.12.0",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.9",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "proxy-addr": "^2.0.8"
  }
}
